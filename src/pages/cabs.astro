---
import Layout from '../layouts/Layout.astro';
import { CABS_DATA } from '../data/cabsData';
import { ShieldCheck, Check, Phone, ArrowRight, MapPin, Clock } from 'lucide-react';
---

<Layout
  title="KSTDC Airport Taxi & Outstation Chauffeur Fleet | Bangalore Airport (BLR)"
  description="Book official Government of Karnataka KSTDC Airport Taxis from Kempegowda International Airport and sanitized outstation chauffeur vehicles."
>
  <div class="py-10 sm:py-16 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {/* Header Strip */}
      <div class="bg-slate-900 text-white p-8 sm:p-12 rounded-[32px] space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 text-emerald-400 text-xs font-semibold">
          <ShieldCheck className="w-4 h-4" />
          <span>Official 24x7 Airport Counters at BLR Terminal 1 & 2</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
          KSTDC Airport Taxi & Outstation Cabs
        </h1>
        <p className="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
          Prepaid, transparent, and GPS-monitored vehicle fleet operated directly by the Karnataka State Tourism Development Corporation. Zero surge pricing.
        </p>
      </div>

      {/* Fleet Grid */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
        {CABS_DATA.map((cab) => (
          <div class="bg-white rounded-[28px] overflow-hidden border border-slate-200 shadow-xs flex flex-col justify-between hover:border-slate-400 transition-all">
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
              <img src={cab.image} alt={cab.name} class="w-full h-full object-cover" />
              <div class="absolute top-4 left-4 bg-slate-900 text-white px-3 py-1 rounded-full text-xs font-bold">
                {cab.type}
              </div>
            </div>

            <div class="p-6 sm:p-7 space-y-5 flex-1 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between text-xs text-slate-500 font-semibold">
                  <span>{cab.seating}</span>
                  <span>•</span>
                  <span>{cab.luggage}</span>
                </div>

                <h2 class="text-2xl font-bold text-slate-900">
                  {cab.name}
                </h2>

                <div class="space-y-2 text-xs text-slate-600">
                  {cab.features.map((f) => (
                    <div class="flex items-center gap-2">
                      <span class="text-emerald-600 font-bold">✓</span>
                      <span>{f}</span>
                    </div>
                  ))}
                </div>

                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs space-y-1">
                  <div class="flex justify-between font-semibold">
                    <span class="text-slate-500">Airport Transfer:</span>
                    <span class="text-slate-900">₹{cab.airportDropPrice.toLocaleString('en-IN')}</span>
                  </div>
                  <div class="flex justify-between font-semibold">
                    <span class="text-slate-500">Outstation Tariff:</span>
                    <span class="text-slate-900">₹{cab.outstationRatePerKm}/km (Min {cab.minKmPerDay} km/day)</span>
                  </div>
                </div>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <span class="text-[11px] text-slate-500 block font-medium">Prepaid Govt Rate</span>
                  <span class="text-2xl font-bold text-slate-900">
                    ₹{cab.airportDropPrice.toLocaleString('en-IN')}
                  </span>
                </div>

                <a
                  href="tel:08043344334"
                  class="px-6 py-3 rounded-full bg-slate-900 hover:bg-black text-white font-bold text-xs shadow-sm transition-all flex items-center gap-2"
                >
                  <Phone className="w-3.5 h-3.5" />
                  <span>Call to Book</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Airport Counter Information */}
      <div class="bg-slate-50 p-8 sm:p-10 rounded-[32px] border border-slate-200 space-y-4">
        <h3 class="text-xl font-bold text-slate-900">
          How to Board at Kempegowda International Airport (BLR)
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl">
          Visit the official KSTDC Airport Taxi counters located immediately at the Terminal 1 and Terminal 2 arrival exits. Collect your printed computerised tariff receipt and board your assigned taxi at Lane 1. 24x7 airport assistance is available at <strong>080-4334 4334</strong>.
        </p>
      </div>

    </div>
  </div>
</Layout>
