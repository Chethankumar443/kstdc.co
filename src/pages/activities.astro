---
import Layout from '../layouts/Layout.astro';
import { ACTIVITIES_DATA } from '../data/activitiesData';
import { ActivitiesBookingEngine } from '../components/activities/ActivitiesBookingEngine';
import { Clock, MapPin, ShieldCheck, Phone } from 'lucide-react';
---

<Layout
  title="KSTDC Activities & City Tours | Ambaari Double Decker & Vidhana Soudha"
  description="Book official KSTDC activities including the Ambaari open-top double-decker bus tour in Mysuru, Vidhana Soudha heritage walks, and Sharavathi water sports."
>
  <div class="py-10 sm:py-16 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {/* Header */}
      <div class="bg-slate-900 text-white p-8 sm:p-12 rounded-[32px] space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 text-emerald-400 text-xs font-semibold">
          <ShieldCheck className="w-4 h-4" />
          <span>Official Conducted City Experiences</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
          KSTDC Activities & City Sightseeing
        </h1>
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
          Experience illuminated Mysuru landmarks from open-roof double-decker coaches, official guided legislative walks, and water sports at prime state destinations.
        </p>
      </div>

      {/* Interactive Activity & Spot Reservation Engine */}
      <ActivitiesBookingEngine client:load />

      {/* Overview Grid */}
      <div class="space-y-4 pt-4">
        <h2 class="text-2xl font-bold text-slate-900">All Conducted Activities</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {ACTIVITIES_DATA.map((act) => (
            <div class="bg-white rounded-[28px] overflow-hidden border border-slate-200 shadow-xs flex flex-col justify-between hover:border-slate-400 transition-all">
              <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
                <img src={act.heroImage} alt={act.title} class="w-full h-full object-cover" />
                <div class="absolute top-4 left-4 bg-slate-900 text-white px-3 py-1 rounded-full text-xs font-bold">
                  {act.city}
                </div>
              </div>

              <div class="p-6 sm:p-7 space-y-5 flex-1 flex flex-col justify-between">
                <div class="space-y-3">
                  <div class="flex items-center gap-2 text-xs text-slate-500 font-semibold">
                    <Clock className="w-3.5 h-3.5 text-slate-900" />
                    <span>{act.duration}</span>
                    <span>•</span>
                    <span>{act.category}</span>
                  </div>

                  <h3 class="text-2xl font-bold text-slate-900 leading-snug">
                    {act.title}
                  </h3>

                  <p class="text-xs text-slate-600 leading-relaxed">
                    {act.description}
                  </p>

                  <div class="space-y-1.5 text-xs text-slate-700">
                    <span class="font-bold text-slate-900 block">Highlights:</span>
                    {act.highlights.map((h) => (
                      <div class="flex items-center gap-2">
                        <span class="text-emerald-600 font-bold">✦</span>
                        <span>{h}</span>
                      </div>
                    ))}
                  </div>

                  <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs">
                    <span class="font-bold text-slate-900 block">Schedule:</span>
                    <span class="text-slate-600">{act.schedule}</span>
                  </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                  <div>
                    <span class="text-[11px] text-slate-500 block font-medium">Ticket Price</span>
                    <span class="text-2xl font-bold text-slate-900">
                      ₹{act.price.toLocaleString('en-IN')}
                      <span class="text-xs font-normal text-slate-500"> / person</span>
                    </span>
                  </div>

                  <a
                    href="#activity-booking"
                    class="px-6 py-3 rounded-full bg-slate-900 hover:bg-black text-white font-bold text-xs shadow-sm transition-all flex items-center gap-2"
                  >
                    <span>Reserve Pass</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</Layout>
